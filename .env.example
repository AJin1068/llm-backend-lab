POSTGRES_USER=llm
POSTGRES_PASSWORD=
POSTGRES_DB=taxsplit
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://llm:@localhost:5432/taxsplit
# LLM (값은 비워 둔다. 키는 .env에만 넣는다)
# fake: 키 없이 정해진 답 / anthropic: 실제 Claude API
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# 채점(judge)용 GPT 키 (PR 11에서 사용, ADR-0006)
OPENAI_API_KEY=
# 비우면 Anthropic 기본 주소. 게이트웨이가 생기면 게이트웨이 주소로 바꾼다
LLM_BASE_URL=
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_TOTAL_TIMEOUT=120
LLM_MAX_TOKENS=4096
# 호출 종류별 모델. 비우면 LLM_MODEL_DEFAULT (ADR-0006)
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_MAIN_AGENT=
LLM_MODEL_PDF_EXTRACT=claude-haiku-5-5
LLM_MODEL_SIM_USER=claude-haiku-5-5
LLM_MODEL_VERIFIER=
LLM_MODEL_JUDGE=
