{
  "permissions": {
    "allow": [
      "Edit(./agent/**)",
      "Write(./agent/**)",
      "Edit(./docs/**)",
      "Write(./docs/**)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull origin main:*)",
      "Bash(git merge main:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./agent/.env)",
      "Bash(cat .env:*)",
      "Bash(cat agent/.env:*)"
    ]
  }
}
